# Copiar a .env privado; Compose lo carga al usar compose.yml de este directorio
# No versionar credenciales reales; los valores requeridos no tienen fallback
COMPOSE_PROJECT_NAME=dev
# Una operacion de Compose a la vez
COMPOSE_PARALLEL_LIMIT=1
PUBLIC_BIND_ADDRESS=0.0.0.0
ROUTING_BIND_ADDRESS=127.0.0.1
SERVICE_RESTART_POLICY=unless-stopped

# PostgreSQL y conexion JNDI de WildFly
# Cambiar las credenciales no modifica usuarios de una base ya inicializada
POSTGRES_IMAGE=postgres:15
POSTGRES_CONTAINER_NAME=postgres
POSTGRES_HOST_PORT=5432
POSTGRES_DATA_DIR=./data/postgres
DB_HOST=postgres
DB_PORT=5432
DB_NAME=mercaforte
DB_USER=mercaforte
DB_PASSWORD=

# WildFly: conservar Java 21 y la imagen actual
WILDFLY_BUILD_CONTEXT=./wildfly
WILDFLY_VERSION=42.0.0.Final-jdk21
WILDFLY_DIGEST=sha256:2bef87441b6f76d388785d3163e894845655221451196f9d4d5b525262450e8e
WILDFLY_CONTAINER_NAME=wildfly
WILDFLY_RESTART_POLICY=always
WILDFLY_HTTP_PORT=8082
WILDFLY_ADMIN_PORT=9990
SPRING_PROFILES_ACTIVE=prod
WILDFLY_DATASOURCE_JNDI_NAME=java:/jdbc/AppDS
BUSINESS_TIME_ZONE=America/Mexico_City

# Reutilizar la clave del backend para conservar los tokens existentes
# JWT_SECRET es obligatorio y debe tener al menos 32 caracteres
JWT_SECRET=
JWT_ISSUER=mercaforte-auth
JWT_AUDIENCE=mercaforte-api
JWT_EXPIRATION_TIME=23:59:59

# Directorio existente del host, escribible por jboss, y destino en el contenedor
VEHICLE_INSPECTION_STORAGE_ROOT=${HOME}/.mercaforte/vehicle-inspections
VEHICLE_INSPECTION_CONTAINER_ROOT=/var/lib/mercaforte/vehicle-inspections

# OSRM sirve el mapa base; su administrador permanece pausado
OSRM_BUILD_CONTEXT=./osrm
OSRM_IMAGE=mercaforte-osrm-routing:6.0.0
OSRM_HOST_PORT=5000
OSRM_DATA_DIR=./data/osrm
OSRM_DATA_FILE=morelos.osrm
OSRM_ALGORITHM=MLD
OSRM_THREADS=2
OSRM_MAX_TABLE_SIZE=1400
OSRM_CPUS=2.0
OSRM_MEMORY_LIMIT=2g
OSRM_STOP_GRACE_PERIOD=30s
ROUTING_MANAGER_URL=http://osrm:5001
# Reutilizar el token privado existente al activar la integracion
ROUTING_MANAGER_TOKEN=

# VROOM; su conexion interna a OSRM esta en VROOM_CONFIG_FILE
VROOM_IMAGE=ghcr.io/vroom-project/vroom-docker:v1.15.0
VROOM_HOST_PORT=3000
VROOM_DATA_DIR=./data/vroom
VROOM_CONFIG_FILE=./configs/vroom/config.yml
VROOM_CPUS=2.0
VROOM_MEMORY_LIMIT=1g

# Nginx: copiar el dist compilado a nginx/dist antes de construir la imagen
NGINX_BUILD_CONTEXT=./nginx
NGINX_BASE_IMAGE=nginx:stable-alpine
NGINX_IMAGE=mercaforte-nginx:dev
NGINX_HTTP_PORT=80
NGINX_API_PREFIX=/mercaforte
NGINX_BACKEND_URL=http://wildfly:8080
NGINX_BACKEND_API_PATH=/api/v1
NGINX_CLIENT_MAX_BODY_SIZE=50m

# Comprobaciones de disponibilidad
HEALTHCHECK_INTERVAL=5s
HEALTHCHECK_TIMEOUT=5s
HEALTHCHECK_RETRIES=10
HEALTHCHECK_START_PERIOD=10s
OSRM_HEALTHCHECK_RETRIES=30
OSRM_HEALTH_REQUEST_TIMEOUT=3
OSRM_HEALTH_COORDINATES=-99.2216,18.9242
VROOM_HEALTH_REQUEST_TIMEOUT=5
