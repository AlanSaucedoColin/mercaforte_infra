# ==============================================================================
# .env.build - Variables de Build
# Usar con: docker compose --env-file .env.build ...
# ==============================================================================

# --- Identidad de Imagen ---
REGISTRY=deverillam
REPO=wildfly-base
IMAGE_TAG=v1.1.3

# --- CI/CD Mock Values ---
# Valores por defecto para builds locales (Jenkins sobreescribe estos)
GIT_COMMIT=commit-example
GIT_BRANCH=branch-name
BUILD_DATE=2026-01-02T13:09:36Z
BUILD_URL=https://localhost/manual-build