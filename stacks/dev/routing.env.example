# Optional database overrides; the manager also imports the road index and refreshes elevations.
ROUTING_DB_NAME=mercaforte
ROUTING_DB_USER=mercaforte
ROUTING_DB_PASSWORD=mercaforte
# Required: choose a random secret of at least 24 characters; use the same value in the backend.
ROUTING_MANAGER_TOKEN=replace-with-a-long-random-secret
ROUTING_PREPARE_TIMEOUT=900
ROUTING_HEALTH_START_PERIOD=35m
